// Deliberately using the legacy "prisma-client-js" generator, NOT the new default
// "prisma-client" generator: as of Prisma 7 the new generator emits TypeScript-only
// output with no compiled JS entry point, which breaks this project's "plain
// JavaScript, no build step" constraint. Do not switch this to "prisma-client".
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATOR
}

// Each value has a matching module in backend/src/ai/csp/.
enum CloudServiceProvider {
  AWS
  AZURE
  GCP
}

enum ChatMode {
  CLOUDOPS
  FINOPS
}

enum FinOpsSubMode {
  TAG_COMPLIANCE
  COST_ANALYTICS
  WASTE_MANAGEMENT
  COST_OPTIMISATION
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMessageKind {
  TEXT
  LOOKUP_REQUEST
  COMMAND_REQUEST
  COMMAND_RESULT
  REASONING
}

enum AiProvider {
  ANTHROPIC
  OPENAI
  GEMINI
  GROQ
  NVIDIA
}

model User {
  id                  String   @id @default(cuid())
  username            String   @unique
  passwordHash        String
  role                UserRole
  isActive            Boolean  @default(true)
  // Envelope-encrypted TOTP secret (backend/src/crypto/); null until enrolled.
  totpSecretEncrypted String?
  // Hashed one-time recovery codes; a code is removed from this list once redeemed.
  backupCodesHashed   String[] @default([])
  // Bumped by every password change or reset; session JWTs carry it as `sv`
  // and are rejected once it no longer matches.
  sessionVersion      Int      @default(0)
  // Set by an admin or CLI reset: the user must choose a new password before
  // anything else works.
  mustChangePassword  Boolean  @default(false)
  // Set by administrators; where password reset links are sent. Lowercased.
  email               String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organisations       UserOrganisation[]
  chatSessions        ChatSession[]
  auditLogs           AuditLog[]
  dashboardWidgets    DashboardWidget[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// Join table: which Organisation(s) an Operator can access.
model UserOrganisation {
  id             String   @id @default(cuid())
  userId         String
  organisationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@map("user_organisations")
}

// Singleton row: this deployment's own white-label branding (not per-Organisation).
model InstanceBranding {
  id                  String   @id @default(cuid())
  displayName         String
  logoObjectKey       String?
  loginImageObjectKey String?
  faviconObjectKey    String?
  updatedAt           DateTime @updatedAt

  @@map("instance_branding")
}

// A client business managed by this instance.
model Organisation {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userOrganisations UserOrganisation[]
  workspaces        Workspace[]

  @@map("organisations")
}

// Organisation -> CSP -> Account -> Environment.
model Workspace {
  id             String               @id @default(cuid())
  organisationId String
  csp            CloudServiceProvider
  account        String
  environment    String
  // A deactivated Workspace is hidden from Operators and cannot run chats.
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organisation     Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  credential       WorkspaceCredential?
  chatSessions     ChatSession[]
  auditLogs        AuditLog[]
  dashboardWidgets DashboardWidget[]

  @@unique([organisationId, csp, account, environment])
  @@map("workspaces")
}

model WorkspaceCredential {
  id                   String   @id @default(cuid())
  workspaceId          String   @unique
  // Envelope-encrypted JSON blob of CSP-specific fields (e.g. AWS access key
  // id/secret), produced by backend/src/crypto/. Never stored in plaintext.
  encryptedCredentials String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_credentials")
}

// Selected model + related chat config. Singleton row, enforced at the service layer.
model ChatSettings {
  id                                   String      @id @default(cuid())
  provider                             AiProvider?
  model                                String
  config                               Json?
  providerApiKeyEncrypted              String?
  baseUrl                              String?
  maxMutatingCommandsPerSessionDefault Int         @default(10)
  sandboxCommandTimeoutSeconds         Int         @default(60)
  sandboxIdleTimeoutMinutes            Int         @default(30)
  spendCeilingUsd                      Decimal?    @db.Decimal(12, 2)
  updatedAt                            DateTime    @updatedAt

  @@map("chat_settings")
}

model ChatSession {
  id                   String         @id @default(cuid())
  userId               String
  workspaceId          String
  mode                 ChatMode
  subMode              FinOpsSubMode?
  // Set from the first user message; the Operator can rename it.
  title                String?
  sandboxContainerId   String?
  sandboxStatus        String?
  sandboxCreatedAt     DateTime?
  sandboxExpiresAt     DateTime?
  mutatingCommandCap   Int            @default(10)
  mutatingCommandCount Int            @default(0)
  // Tokens in the most recent model call (input + output) and the model's
  // context window at that time; shown as a usage ring in the chat header.
  contextTokens        Int?
  contextWindow        Int?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user      User          @relation(fields: [userId], references: [id])
  workspace Workspace     @relation(fields: [workspaceId], references: [id])
  messages  ChatMessage[]
  auditLogs AuditLog[]

  @@index([userId])
  @@index([workspaceId])
  @@map("chat_sessions")
}

model ChatMessage {
  id            String          @id @default(cuid())
  sessionId     String
  role          ChatMessageRole
  kind          ChatMessageKind @default(TEXT)
  // Natural-language text, or the literal command/lookup string proposed.
  content       String
  // Sanitized stdout/stderr for command or lookup results.
  commandOutput String?
  // Free-form lifecycle state (e.g. pending_confirmation/confirmed/cancelled/
  // executed/failed) -- kept as a string since the exact vocabulary is defined
  // by the Phase 6 agent execution flow, not the data model.
  status        String?
  createdAt     DateTime        @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

// Independent of chat history so it survives even if a session/user/workspace
// is later removed -- actor/workspace are nulled out, never cascade-deleted.
model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  workspaceId   String?
  chatSessionId String?
  action        String
  outcome       String?
  metadata      Json?
  createdAt     DateTime @default(now())

  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  chatSession ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([workspaceId])
  @@index([createdAt])
  @@index([chatSessionId])
  @@map("audit_logs")
}

model AgentPersona {
  id                 String         @id @default(cuid())
  mode               ChatMode
  subMode            FinOpsSubMode?
  modeKey            String         @unique
  systemPrompt       String
  allowedBinaries    String[]       @default([])
  docLookupAllowed   Boolean        @default(true)
  mutatingCommandCap Int?
  updatedByUserId    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("agent_personas")
}

// One graph on an Operator's own dashboard for a Workspace and mode. The saved
// command is re-run without the model; only read-only commands are ever run.
model DashboardWidget {
  id              String    @id @default(cuid())
  userId          String
  workspaceId     String
  mode            ChatMode
  title           String
  // The Operator's natural-language request this graph was authored from.
  query           String
  // CLI command; may contain {{start}} / {{end}} / {{end_inclusive}}.
  commandTemplate String
  // A chain of commands, [{ command, rowsPath }], when one command is not
  // enough (backend/src/ai/dashboard/chain.js); commandTemplate is then its
  // first command. Null for a one-command graph.
  steps           Json?
  // A DASHBOARD_PERIODS value (backend/src/constants/dashboard.js).
  period          String
  chartSpec       Json
  chartHtml       String? // the AI-written page that draws the graph
  // The last successful result; kept when a later refresh fails.
  lastResult      Json?
  lastRunAt       DateTime?
  lastAttemptAt   DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, mode])
  @@map("dashboard_widgets")
}

// One emailed password reset link. Only the SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum MailSecurity {
  NONE
  STARTTLS
  TLS
}

// Outgoing SMTP mail for password reset links. Singleton row, enforced at the service layer.
model MailSettings {
  id                String       @id @default(cuid())
  enabled           Boolean      @default(false)
  host              String?
  port              Int?
  security          MailSecurity @default(STARTTLS)
  username          String?
  passwordEncrypted String?
  fromAddress       String?
  fromName          String?
  // Browser-facing base URL of the web app; reset links point here.
  publicAppUrl      String?
  updatedAt         DateTime     @updatedAt

  @@map("mail_settings")
}
